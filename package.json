{
  "name": "convite-casamento-monolith",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json && vite build && cp dist/public/web-react/index.html dist/public/index.html",
    "start": "tsx server/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push --skip-generate && npm run db:seed"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.4.0",
    "jose": "^6.0.10",
    "xlsx": "^0.18.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prisma": "^6.7.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}