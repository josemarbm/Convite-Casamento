generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(80)
  email        String   @unique @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Event {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(120)
  eventType  String    @default("wedding") @map("event_type") @db.VarChar(30)
  customType String?   @map("custom_type") @db.VarChar(80)
  hosts      String?   @db.VarChar(200)
  dateTime   DateTime? @map("date_time")
  location   String?   @db.VarChar(200)
  address    String?   @db.Text
  imagePath  String?   @map("image_path") @db.Text
  systemKey  String?   @unique @map("system_key") @db.VarChar(50)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  guests         Guest[]
  groups         Group[]
  messageTemplates MessageTemplate[]
  scheduledSends ScheduledSend[]

  @@index([archivedAt])
  @@map("events")
}

model Guest {
  id               Int       @id @default(autoincrement())
  eventId          Int?      @map("event_id")
  name             String    @db.VarChar(200)
  phone            String    @db.VarChar(50)
  groupId          Int?      @map("group_id")
  status           String?   @default("pending") @db.VarChar(20)
  sentAt           DateTime? @map("sent_at")
  rsvpTokenHash    String?   @unique @map("rsvp_token_hash") @db.VarChar(64)
  rsvpStatus       String    @default("pending") @map("rsvp_status") @db.VarChar(20)
  rsvpRespondedAt  DateTime? @map("rsvp_responded_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id])
  group Group? @relation(fields: [groupId], references: [id])

  @@index([eventId])
  @@index([groupId])
  @@map("guests")
}

model MessageTemplate {
  id        Int      @id @default(autoincrement())
  eventId   Int?     @map("event_id")
  name      String   @db.VarChar(100)
  content   String   @db.Text
  isDefault Boolean? @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  event          Event?          @relation(fields: [eventId], references: [id])
  scheduledSends ScheduledSend[]

  @@index([eventId])
  @@map("message_templates")
}

model Group {
  id          Int      @id @default(autoincrement())
  eventId     Int?     @map("event_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  event         Event?          @relation(fields: [eventId], references: [id])
  guests        Guest[]
  scheduledSends ScheduledSend[]

  @@index([eventId])
  @@map("groups")
}

model ScheduledSend {
  id            Int       @id @default(autoincrement())
  eventId       Int?      @map("event_id")
  templateId    Int       @map("template_id")
  groupId       Int?      @map("group_id")
  guestIds      String?   @map("guest_ids") @db.Text
  scheduledTime DateTime  @map("scheduled_time")
  status        String?   @default("pending") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  event    Event?          @relation(fields: [eventId], references: [id])
  template MessageTemplate @relation(fields: [templateId], references: [id])
  group    Group?          @relation(fields: [groupId], references: [id])

  @@index([eventId])
  @@index([groupId])
  @@index([templateId])
  @@map("scheduled_sends")
}

model Setting {
  key   String @id @db.VarChar(100)
  value String @db.Text

  @@map("settings")
}